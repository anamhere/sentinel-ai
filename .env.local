# ── Sentinel AI — Frontend Environment ──────────────────────────────────────
#
# VITE_API_URL     = base URL for API fetch calls (stats, history, logs, alerts)
# VITE_STREAM_URL  = base URL for the MJPEG stream (MUST be direct, no proxy)
#
# ── Local development (default — no changes needed) ──────────────────────────
# API calls go through Vite proxy → leave VITE_API_URL blank or unset
# Stream goes direct to backend on port 8000
VITE_STREAM_URL=http://localhost:8000

# ── Mobile on same WiFi ───────────────────────────────────────────────────────
# Uncomment and replace with your machine's local IP (run ipconfig to find it)
# VITE_API_URL=http://192.168.1.X:8000
# VITE_STREAM_URL=http://192.168.1.X:8000

# ── Production / cloud deployment ────────────────────────────────────────────
# VITE_API_URL=https://copious-marxism-sneeze.ngrok-free.dev
# VITE_STREAM_URL=https://copious-marxism-sneeze.ngrok-free.dev
