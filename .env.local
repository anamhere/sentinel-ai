# For local development (default — no change needed)
VITE_API_URL=http://localhost:8000

# For mobile access on same WiFi:
# 1. Run: ipconfig  → find your IPv4 (e.g. 192.168.1.5)
# 2. Uncomment line below and replace IP:
# VITE_API_URL=http://192.168.1.5:8000

# For Render/Railway deployment (set your deployed backend URL):
# VITE_API_URL=https://sentinel-ai-backend.onrender.com
