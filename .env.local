# ── Sentinel AI — Frontend Environment ──────────────────────────────────────
#
# LOCAL DEV:   API → Vite proxy → localhost:8000
#              Stream → direct to localhost:8000/video
#
# VERCEL:      API → /api/* → Vercel proxy.js → Cloudflare tunnel → your PC
#              Stream → DIRECT to Cloudflare tunnel (bypasses Vercel timeout)
#              Set VITE_STREAM_URL + NGROK_URL in Vercel Dashboard

# ── Local development (no changes needed) ────────────────────────────────────
VITE_STREAM_URL=http://localhost:8000

# ── Production / Vercel ───────────────────────────────────────────────────────
# Set these in Vercel Dashboard → Settings → Environment Variables
# VITE_STREAM_URL=https://cart-recruitment-empire-accepts.trycloudflare.com
# NGROK_URL=https://cart-recruitment-empire-accepts.trycloudflare.com
# VITE_API_URL → leave blank/unset on Vercel (uses /api proxy automatically)
